# 카카오 JavaScript 키 (카카오톡 공유용, https://developers.kakao.com 에서 발급)
# 미설정 시 카카오 공유 버튼은 자동으로 숨겨지고 나머지 공유 기능은 정상 동작한다
VITE_KAKAO_JS_KEY=

# 배포 사이트의 정식 URL (공유 링크/OG 태그 생성에 사용). 미설정 시 브라우저 origin 을 사용
VITE_SITE_URL=https://example.com

# 하위 경로 배포(GitHub Pages 등) 시 base 경로. 예: /anime-mbti/
# 미설정 시 "/" 로 배포된다
VITE_BASE=/
